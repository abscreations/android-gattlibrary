{
  "family": "vendor.life_fitness.discover_se.framing.qz_issue_3374",
  "source": "QZ issue #3374 official Life Fitness app HCI capture",
  "sourceUrl": "https://github.com/cagnulein/qdomyos-zwift/issues/3374",
  "model": "Life Fitness 95T with Discover SE console",
  "captureFile": "03-btsnoop_hci.log",
  "captureSha256": "2704bc4e8d0cd535a4e4698f171d57390a82589d3abb57c33d97a2d00ecf87af",
  "extracted": "2026-08-25",
  "acquisition": "sanitized-hci-extraction",
  "extractionFilter": "cid == 0x0004 && handle in (0x4002 notify, 0x4004 write) - ALL lengths, not only 40",
  "evidenceTier": "upstream hardware-observed single-capture evidence; not FitBridge tier H",
  "vendor": "Life Fitness",
  "persona": "treadmill",
  "status": "DESCRIPTIVE ONLY. Plan V2 records the Discover SE console as a confirmed variant split that needs its own fingerprint, fixtures and evidence review before any code parses it. This fixture is the framing half of that review. Nothing in FitBridge reads it yet, and nothing should until that branch is opened.",
  "why": [
    "The 2026-08-13 extraction from this log filtered on 'payload length == 40' and captured only",
    "the measurement stream. The same characteristic also carries a framed transport with chunked",
    "XML and JSON on it - workout libraries, a profile block and a per-session workout summary -",
    "and the write characteristic carries the client half of the same framing.",
    "Recording the frame layer separately keeps the measurement corpus a pure replay corpus while",
    "making the transport reviewable."
  ],
  "framing": {
    "shortFrame": "F1 | 0x00 | length | payload[length] | checksum",
    "longFrame": "F1 | 0x01 | chunkPayloadLength | messageId | chunkIndex | messageType | payload...",
    "checksum": "short frames only: (0x100 - (sum of every octet after F1 and before the checksum)) mod 256. Equivalently the whole frame including F1 and the checksum sums to 0xF1 mod 256, which is the rule already recorded in life_fitness_issue_3374_discover_se_measurements.json for the 40-byte case. This fixture confirms that rule generalises to every short frame in the capture, not only the measurements.",
    "longFrameChecksum": "NOT ESTABLISHED. Long frames are reassembled across multiple ATT writes and the trailing octets of each chunk do not satisfy the short-frame rule. Do not assume one.",
    "continuationWrites": "Some long messages spill a few trailing octets into a following ATT write that carries no F1 header at all. Any reassembler must treat the ATT write boundary and the frame boundary as unrelated.",
    "reassembledPayloads": "UTF-8 XML (a <discover> profile/auth envelope, a <workout> preset, a <workout-summary> with elapsed time, calories, distance and average speed/pace/incline/METs/watts) and UTF-8 JSON (a workoutSummaries library index)."
  },
  "observations": {
    "authenticationIsNotValidated": "The client's <authentication> block writes the literal string 'faketoken' as token, secret and signature, plus a 32-character hmac_token. The console accepted the envelope and streamed measurements for the rest of the session. Read narrowly: this console did not reject an obviously fabricated credential. It is NOT evidence that no Discover SE console ever validates one, and it is not a licence to ship a fabricated credential.",
    "noFtms": "This machine exposes no 0x1826 at all - its entire GATT is 0x1800, 0x1801, 0x180A and fb694b90-f49e-4597-8306-171bba78f846. The standard-FTMS Life Fitness path cannot reach it, which is the concrete form of the V2 variant split.",
    "sharedServiceUuidDifferentCharacteristics": "fb694b90-f49e-4597-8306-171bba78f846 is the SAME service UUID the setup-gated standard-FTMS machine in issue #1018 exposes, but with an entirely different characteristic set (4a8ff3f1/c52d3161 here; the 5da5.../ce78... family there). Matching this family on the service UUID alone would mis-fingerprint one variant as the other. Characteristic-level evidence is mandatory."
  },
