      "average_500m_pace_s": 16,
      "instant_500m_pace_s": 17,
      "average_1000m_pace_s": 18,
      "instant_1000m_pace_s": 19,
      "average_force_newtons": 20,
      "force_newtons": 21,
      "elapsed_seconds": 22,
      "coverage_window_seconds": 23
    },
    "decimal_field_indexes": [9, 10, 11, 20, 21],
    "integer_field_indexes": [1, 7, 12, 13, 14, 15, 16, 17, 18, 19, 22],
    "lenient_field_indexes": [23],
    "lenient_field_rule": "Field 23 is a time weight, not a gate. It is consumed, but an empty, signed, non-numeric or absent value yields no window rather than a rejection, and the caller falls back to the elapsed delta. Nothing in field 23 can cost a frame.",
    "ignored_field_indexes_within_first_24": [2, 3, 4, 5, 6, 8],
    "unsigned_integer_grammar": "DIGIT+",
    "unsigned_decimal_grammar": "DIGIT+(DOT DIGIT+)?",
    "bounds": {
      "speed_kmh_inclusive": [0.0, 40.0],
      "average_speed_kmh_inclusive": [0.0, 40.0],
      "cadence_spm_inclusive": [0, 120],
      "average_cadence_spm_inclusive": [0, 120],
      "active_paddling_domain": [0, 1],
      "force_newtons": "no ceiling is asserted. A newton bound would be invented: no capture, decompilation or third-party client states one, and section 19's degeneracy caveat means the unit itself is a converged interpretation rather than a proven one.",
      "coverage_window_seconds": "unbounded on receive; clamped to 3600 downstream when used as an integration weight",
      "distance_m": "non-negative finite decimal; no fixed ceiling; continuity growth gate",
      "elapsed_seconds": "non-negative signed-64-bit integer; no fixed ceiling; monotonic within a session"
    },
    "field_semantics": {
      "note": "Evidence class per field, so a reader can tell what is observed from what is interpreted. OBSERVED = seen in a physical-console capture or pinned TMIW source. CONVERGED = agreed by FitBridge and the shipping KayakFit Bull client against real hardware, but not proven against console ground truth. UNRESOLVED = present on the wire, meaning unknown, deliberately not consumed.",
      "0": { "name": "command", "value": "6", "class": "OBSERVED" },
      "1": { "name": "event timestamp (ms)", "class": "OBSERVED", "consumed": true },
      "2": { "name": "unknown", "class": "UNRESOLVED", "consumed": false },
      "3": { "name": "unknown", "class": "UNRESOLVED", "consumed": false },
      "4": { "name": "unknown", "class": "UNRESOLVED", "consumed": false },
      "5": { "name": "unknown decimal", "class": "UNRESOLVED", "consumed": false },
      "6": { "name": "unknown", "class": "UNRESOLVED", "consumed": false },
      "7": { "name": "active paddling flag", "class": "CONVERGED", "consumed": true, "note": "KayakFit D002 makes this the session activity signal, not a freshness flag" },
      "8": { "name": "unknown", "class": "UNRESOLVED", "consumed": false },
      "9": { "name": "total distance (m)", "class": "OBSERVED", "consumed": true },
      "10": { "name": "average speed (m/s)", "class": "OBSERVED", "consumed": true },
      "11": { "name": "instantaneous speed (m/s)", "class": "OBSERVED", "consumed": true },
      "12": { "name": "average stroke rate (spm)", "class": "OBSERVED", "consumed": true },
      "13": { "name": "instantaneous stroke rate (spm)", "class": "OBSERVED", "consumed": true },
      "14": { "name": "average 200m pace (s)", "class": "OBSERVED", "consumed": true },
      "15": { "name": "instantaneous 200m pace (s)", "class": "OBSERVED", "consumed": true },
      "16": { "name": "average 500m pace (s)", "class": "OBSERVED", "consumed": true },
      "17": { "name": "instantaneous 500m pace (s)", "class": "OBSERVED", "consumed": true },
      "18": { "name": "average 1000m pace (s)", "class": "OBSERVED", "consumed": true },
      "19": { "name": "instantaneous 1000m pace (s)", "class": "OBSERVED", "consumed": true },
      "20": { "name": "average pull force (N)", "class": "CONVERGED", "consumed": true, "note": "newton typing is shared with KayakFit; section 19 records that a proportional raw unit would fit the same evidence" },
      "21": { "name": "instantaneous pull force (N)", "class": "CONVERGED", "consumed": true, "note": "never power. Decimal-tolerant on receive, integer on transmit: KayakFit types it as an integer and drops any frame carrying a decimal point" },
      "22": { "name": "elapsed session time (s)", "class": "OBSERVED", "consumed": true },
      "23": { "name": "coverage window (s)", "class": "CONVERGED", "consumed": true, "note": "KayakFit D005. Explains the captured 0/1/5 values exactly, but is an interpretation from field behaviour rather than decompiled proof, and KayakFit's own documentation hedges it" }
    }
  },
