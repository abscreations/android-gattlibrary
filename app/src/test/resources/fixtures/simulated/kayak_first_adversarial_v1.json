  "privacy_expectations": {
    "forbidden_data_classes": [
      "real Bluetooth address",
      "real console identifier",
      "absolute capture wall-clock timestamp",
      "real device epoch",
      "real user or athlete weight",
      "account identifier",
      "profile or health value",
      "store or product token",
      "unrelated scanned device"
    ],
    "allowed_protocol_constants": [
      "normalized epoch values",
      "neutral weight 80 from TMIW",
      "relative milliseconds",
      "pseudonymous fixture identifiers"
    ],
    "ordinary_log_policy": "state, command name, byte length, relative timing, evidence label, and rejection code only; raw protocol payloads require an armed structurally redacted BLECAP session"
  },
  "coverage_manifest": [
    "every byte split of one representative 24-field measurement",
    "byte-at-a-time and 20-byte fragmentation",
    "coalesced complete lines and retained partial suffixes",
    "CR/LF split and lone-LF behavior",
    "binary reset variants, NUL, invalid UTF-8, all-zero and all-one noise",
    "512-byte boundary, overflow clearing, and recovery, against the 4096-byte production cap",
    "every truncated field count from 0 through 23",
    "every one of the seventeen consumed fields: empty, negative, lower-bound, syntax and overflow families",
    "instantaneous and average speed and stroke-rate plausibility edges",
    "the field-7 activity flag inside and outside its 0/1 domain",
    "force accepted as decimal on receive, and with no invented newton ceiling",
    "field 23 leniency: empty, signed, non-numeric, zero, ordinary and clamped windows",
    "extra fields ignored after the first 24",
    "distance and elapsed continuity, accepted-start reset, and reconnect reset",
    "TMIW-authoritative writes and captured simulator-only dialects",
    "reset, handshake, display, poll, start, stop, and unknown responses",
    "wrong, late, negative, missing, exhausted, cancelled, stale-generation, and reconnect setup events",
    "single-write start and stop behavior plus scheduled polling without burst retries",
    "partial-frame clearing and stale-notification rejection across link generations",
    "privacy exclusions"
  ]
}
